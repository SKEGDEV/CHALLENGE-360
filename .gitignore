# ==========================================
# Node (backend Express + frontend React)
# ==========================================
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# ==========================================
# Backend (Express / TypeScript)
# ==========================================
backend/dist/
backend/build/
backend/coverage/

# ==========================================
# Frontend (React - CRA / Vite / Next agnostic)
# ==========================================
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.next/
frontend/.cache/
frontend/coverage/

# ==========================================
# Variables de entorno (nunca se suben secretos/credenciales)
# ==========================================
.env
.env.local
.env.*.local
!.env.example

# ==========================================
# SQL Server / artefactos de base de datos
# ==========================================
*.mdf
*.ldf
*.ndf
*.bak
*.trn

# ==========================================
# Logs
# ==========================================
logs/
*.log

# ==========================================
# Editor / OS
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
