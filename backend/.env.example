PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=1209600

# AWS (floci / LocalStack-compatible emulator on localhost:4566)
# Use the access key of an IAM user scoped only to S3_BUCKET_NAME and the secrets below.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=replace-with-iam-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-iam-secret-access-key
S3_BUCKET_NAME=challenge-bucket
# How long a presigned upload URL stays valid (seconds)
PRESIGNED_URL_EXPIRATION_SECONDS=900

# Names of the secrets in Secrets Manager the API reads at startup:
# - SECRET_DB_CONNECTION_STRING_NAME -> SQL Server connection string (string secret)
# - SECRET_S3_CREDENTIALS_NAME -> JSON {accessKeyId, secretAccessKey, bucket, region}
# - SECRET_SMTP_CREDENTIALS_NAME -> JSON {host, port, user, pass, fromAddress, fromName} (Gmail SMTP)
# - SECRET_SQS_CREDENTIALS_NAME -> JSON {accessKeyId, secretAccessKey, region}, scoped only to the queues below
SECRET_DB_CONNECTION_STRING_NAME=shopcart/db-connection-string
SECRET_S3_CREDENTIALS_NAME=shopcart/s3-credentials
SECRET_SMTP_CREDENTIALS_NAME=shopcart/smtp-credentials
SECRET_SQS_CREDENTIALS_NAME=shopcart/sqs-credentials

# Shipment status notification queue (SQS, non-sensitive config; credentials live in Secrets Manager above).
# The API creates both queues on startup if they don't exist yet, wiring the DLQ via RedrivePolicy.
SQS_QUEUE_NAME=shopcart-shipment-notifications
SQS_DLQ_NAME=shopcart-shipment-notifications-dlq
SQS_MAX_RECEIVE_COUNT=5
SQS_WAIT_TIME_SECONDS=10

# Pre order (cart) expiration worker
PREORDER_EXPIRATION_MINUTES=15
PREORDER_WORKER_INTERVAL_MS=1000

# IVA tax percentage applied to every invoice subtotal
TAX_IVA_PERCENTAGE=12
