PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=1209600

# AWS (floci / LocalStack-compatible emulator on localhost:4566)
# Use the access key of an IAM user scoped only to S3_BUCKET_NAME and the secrets below.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=replace-with-iam-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-iam-secret-access-key
S3_BUCKET_NAME=challenge-bucket

# Names of the secrets in Secrets Manager the API reads at startup:
# - SECRET_DB_CONNECTION_STRING_NAME -> SQL Server connection string (string secret)
# - SECRET_S3_CREDENTIALS_NAME -> JSON {accessKeyId, secretAccessKey, bucket, region}
SECRET_DB_CONNECTION_STRING_NAME=shopcart/db-connection-string
SECRET_S3_CREDENTIALS_NAME=shopcart/s3-credentials
